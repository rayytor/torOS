+/* torOS: put a child at a given place (pinned applications come first on
+ * the dock, in the order they are listed) */
+void flow_grid_child_reorder ( GtkWidget *self, GtkWidget *child, guint pos )
+{
+  FlowGridPrivate *priv;
+
+  g_return_if_fail(IS_FLOW_GRID(self));
+  priv = flow_grid_get_instance_private(FLOW_GRID(self));
+
+  if(!g_list_find(priv->children, child))
+    return;
+  priv->children = g_list_remove(priv->children, child);
+  priv->children = g_list_insert(priv->children, child, pos);
+  flow_grid_invalidate(self);
+}
+
