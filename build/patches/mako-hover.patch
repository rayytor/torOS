+/* torOS: a notification reacts to the pointer, as everything else that can be
+ * clicked does. Mark the one under the pointer; render.c draws it differently. */
+static void update_hover(struct mako_state *state) {
+	struct mako_notification *notif;
+	wl_list_for_each(notif, &state->notifications, link) {
+		bool hovered = false;
+		struct mako_seat *seat;
+		wl_list_for_each(seat, &state->seats, link) {
+			if (seat->pointer.surface != NULL &&
+					seat->pointer.surface == notif->surface &&
+					hotspot_at(&notif->hotspot, seat->pointer.x, seat->pointer.y)) {
+				hovered = true;
+			}
+		}
+		if (hovered != notif->hovered) {
+			notif->hovered = hovered;
+			set_dirty(notif->surface);
+		}
+	}
+}
