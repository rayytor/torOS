# torOS labwc environment
XKB_DEFAULT_LAYOUT=us,tr
XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24
# GTK4 compose handling without an input method daemon
GTK_IM_MODULE=simple
# Do not start the accessibility bus for every GTK app (saves RAM and startup time)
GTK_A11Y=none
NO_AT_BRIDGE=1
# libadwaita apps read light/dark straight from the desktop settings that
# toros-theme changes (there is no settings portal to ask)
ADW_DISABLE_PORTAL=1
# GTK4 apps: the OpenGL renderer starts faster and uses less memory than Vulkan
# on this laptop's graphics chip
GSK_RENDERER=ngl
