# torOS panel, derived from sfwbar's default sfwbar.config (v1.0_beta17).
# Started by /etc/xdg/labwc/autostart.
#Api2

# Override gtk theme
#Theme = "Adwaita-dark"

# Override gtk icon theme
#IconTheme = "Adwaita"

# Set default icon search path
Set ImagePath = "icons/misc"

# Set a hint for bar thickness (CSS should use this is calculate sizes).
Set ThicknessHint = "30px"

# Display minimized windows on taskbars across all outputs
# DisownMinimized = true

TriggerAction "SIGRTMIN+1", SwitcherEvent("forward");
TriggerAction "SIGRTMIN+2", SwitcherEvent("back");
# Test hook: "pkill -RTMIN+5 sfwbar" opens the Wi-Fi password window
TriggerAction "SIGRTMIN+5", EmitTrigger("wifi-secret");

# The panel's windows close when something else is clicked, as on GNOME
Function SfwbarInit() {
  Config "PopUp 'XQuick' { AutoClose = true }"
  Config "PopUp 'XWifiWindow' { AutoClose = true }"
  Config "PopUp 'XBluezWindow' { AutoClose = true }"
  Config "PopUp 'SessionPopup' { AutoClose = true }"
  Config "PopUp 'Xcal' { AutoClose = true }"
}

# Window Placer
placer {
  xorigin = 5  # place the first window at X% from the left
  yorigin = 5  # place the first window at X% from the top
  xstep = 5    # step by X% of desktop horizontally
  ystep = 5    # step by X% of desktop vertically
  children = true
}

# Task Switcher
switcher {
  disable = false
  interval = 700
  icons = true
  labels = false
  cols = 5
#  filter = workspace
}

include "winops.widget"

# Dock: bottom centre, big icons. The bar shrinks to its content ("size" is
# only a minimum), so it floats in the middle of the bottom edge.
bar "dock" {
  edge = "bottom"
  halign = "center"
  size = "20"
  margin = 6
  layer = "top"
  mirror = "*"
  exclusive_zone = "auto"

# The logo opens the overview, as the Super key does
  button {
    value = "/usr/share/toros/logo.png"
    style = "dock_launcher"
    tooltip = "Applications and search (Super)"
    action = Exec("toros-overview")
  }

# Like GNOME's dash: one icon per application. The pinned ones are always
# there; a click starts the application or brings back its last used window,
# a second click lists its windows when it has several, a middle click or
# Ctrl+click opens another window, scrolling goes through its windows.
# (pins and these clicks are a torOS patch: build/patches/sfwbar-dock.patch)
  taskbar {
    style = "taskbar"
    rows = 1;
    tooltips = true;
    icons = true;
    labels = false;
    sort = false;
    group = popup;
    group cols = 1;
    group icons = true;
    group labels = true;
    group title_width = 40;
    group style = "dock_windows";
    pins = "thorium-browser", "org.gnome.Nautilus", "io.github.oynaz.Oynaz", "foot";
    action[RightClick] = Menu("winops");
  }
}

# Status panel: vertical strip on the right edge, in the order of GNOME's top
# bar read downwards: workspaces, background apps (tray), keyboard layout,
# the keyboard on the screen, the hearing aid, quick settings, clock.
bar "status" {
  edge = "right"
  valign = "center"
  size = "20"
  margin = 6
  layer = "top"
  mirror = "*"
  exclusive_zone = "auto"

# Workspaces: a dot each in a 2x2 block, the current one is filled. Click to
# switch (Super+PageUp/PageDown or Ctrl+Alt+Left/Right from the keyboard). The
# names are the ones in labwc's rc.xml.
  pager {
    style = "pager"
    cols = 2
    preview = false
    pins = "1", "2", "3", "4"
  }

  tray {
    style = "tray"
    cols = 1
  }

  widget "privacy.widget" {
    audio_icon = "audio-input-microphone";
    video_icon = "camera-web";
  }

# The flag of the keyboard layout; a click or Super+Space changes it
  widget "toros-language.widget"

# The keyboard on the screen (toros-keyboard): a click shows it, brings it
# back from the edge of the screen, or closes it, as Super+Ctrl+O does.
  button {
    value = "input-keyboard-symbolic"
    class = "module"
    tooltip = "On-screen keyboard (Super+Ctrl+O)"
    action = Exec("toros-keyboard")
  }

# One-click connect/disconnect for the hearing aid in /etc/toros/hearing-aid.
  button {
    value = "audio-headphones-symbolic"
    class = "module"
    tooltip = "Hearing aid: connect / disconnect (Super+B)"
    action = Exec("toros-bt toggle")
  }

# Network, sound and battery icons: one button that opens the quick settings
  widget "toros-quick.widget"

  widget "clock.widget" {
    disable = false;
    time_format = "%H\n%M"
    tooltip_format = "%A %e %B %Y"
    week_starts_on_sunday = false
    reset_on_popup = false
  }

# Power button, last on the strip; the one in the quick settings opens the
# same window. Its rows are in the widget: all but "Lock" have to be held.
  widget "toros-session.widget"
}

#CSS
#hidden {
  -GtkWidget-visible: false;
}
#red { background-color: red; }

button,
button image {
  min-height: 0px;
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
}

label {
  font-family: Sans;
  font-size: calc(@bar_thickness * 0.7);
}

image {
  -ScaleImage-symbolic: true;
}

.module,
button#startmenu,
button#module {
  border: none;
  padding: calc(@bar_thickness * 0.1);
  margin: 0px;
  -GtkWidget-vexpand: true;
}

.module:hover,
button#startmenu:hover,
button#module:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

.module image,
button#startmenu image,
button#module image {
  padding: 0px;
  margin: 0px;
  min-width: calc(@bar_thickness * 0.8);
  min-height: calc(@bar_thickness * 0.8);
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
  color: @theme_fg_color;
}

.focused {
  background-color: alpha(@theme_fg_color, 0.16);
}

.urgent label {
  color: red;
}

/* taskbar CSS properties */

button#taskbar_item {
  padding: calc(@bar_thickness * 0.1);
  border-radius: 0px;
  border-width: 0px;
  -GtkWidget-hexpand: false;
}

grid#taskbar > :not(:last-child) button#taskbar_item {
  border-radius: 0px;
  border-right: 1px solid alpha(@theme_fg_color,0.15);
}

button#taskbar_item.minimized label {
  color: alpha(currentColor, 0.6);
}

button#taskbar_item:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

button#taskbar_item grid {
  -GtkWidget-valign: center;
}

button#taskbar_item image {
  min-height: calc(@bar_thickness * 0.8);
  min-width: calc(@bar_thickness * 0.8);
  padding-right: calc(@bar_thickness * 0.25);
  padding-left: calc(@bar_thickness * 0.25);
  -ScaleImage-symbolic: false;
  -GtkWidget-vexpand: true;
}

button#taskbar_item label {
}

/* pager CSS properties */

grid#pager {
  border-radius: calc(@bar_thickness * 0.1);
  border-color: @theme_fg_color;
  border-style: solid;
  border-width: 1px;
  margin: calc(@bar_thickness * 0.1);
  padding: 0px;
}

button#pager_item {
  border-radius: calc(@bar_thickness * 0.25);
  border: none;
  outline: 0px;
  margin-right: 2px;
  margin-left: 2px;
  padding: 0px;
  -GtkWidget-halign: center;
  -GtkWidget-valign: center;
}

button#pager_item label {
  font-size: calc(@bar_thickness*0.8 - 2px);
}

button#pager_preview {
  border-radius: 0;
  border-color: #000000;
  border-width: 0.25mm;
  color: #777777;
  min-width: 5cm;
  min-height: 2.8125cm;
}

/* tray CSS properties */

button#tray_item {
  margin: 0px;
  border: none;
  padding: 0px;
}

button#tray_item.passive {
  -GtkWidget-visible: false;
}

button#tray_item image {
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
  padding: 3px;
  margin: 0px;
  border: none;
}

/* switcher CSS properties */

window#switcher { 
  border: 1px solid alpha(@theme_fg_color, 0.12);
  border-radius: 16px; 
  padding: 60px; 
  -GtkWidget-hexpand: true;
}

grid#switcher_item.focused image,
grid#switcher_item.focused {
  background-color: alpha(@theme_fg_color, 0.14);
}

grid#switcher_item image,
grid#switcher_item {
  min-width: 50px;
  min-height: 50px;
  border-radius: 12px;
  padding: 5px;
  -GtkWidget-direction: right;
  -GtkWidget-hexpand: true;
  -ScaleImage-symbolic: false;
}

grid#switcher { 
  border-radius: 5px;
  padding: 5px;
  -GtkWidget-hexpand: true;
}

#menu_item,
#menu_item image,
#menu_item label {
  -GtkWidget-halign: start;
}

menuitem image {
  min-width: 16px;
  min-height: 16px;
  padding-right: 2px;
}

chart#cpu {
  background: rgba(127,127,127,0.3);
  min-width: 9px;
  -GtkWidget-vexpand: true;
  margin: 2px;
  border: 1px solid @theme_fg_color;
  color: red;
}

progressbar#memory {
  -GtkWidget-direction: top;
  -GtkWidget-vexpand: true;
  min-width: 9px;
  border: 1px solid @theme_fg_color;
  margin: 2px;
}

progressbar#memory trough {
  min-height: 2px;
  min-width: 9px;
  border: none;
  border-radius: 0px;
  background: rgba(127,127,127,0.3);
}

progressbar#memory progress {
  -GtkWidget-hexpand: true;
  min-width: 9px;
  border-radius: 0px;
  border: none;
  margin: 0px;
  background-color: alpha(green,0.9);
}

label#language {
  margin-left: 3px;
  margin-right: 5px;
}

/* ---- torOS: floating dock and status panel ---- */

window#dock,
window#status {
  background: rgba(0,0,0,0);
}

window#dock grid#layout,
window#status grid#layout {
  background-color: @popover_bg_color;
  border-radius: 18px;
  border: 1px solid alpha(@theme_fg_color, 0.12);
}

window#dock grid#layout {
  padding: 4px 8px;
}

window#status grid#layout {
  padding: 7px 4px;
  -GtkWidget-direction: bottom;
}

/* big dock icons */
button#dock_launcher,
button#taskbar_popup {
  border: none;
  border-radius: 12px;
  padding: 5px;
  margin: 0px 2px;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
}

button#dock_launcher:hover,
button#taskbar_popup:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

button#taskbar_popup.focused {
  background-color: alpha(@theme_fg_color, 0.14);
}

button#taskbar_popup.focused:hover {
  background-color: alpha(@theme_fg_color, 0.20);
}

button#dock_launcher image,
button#taskbar_popup image {
  min-width: 44px;
  min-height: 44px;
  padding: 0px 0px 3px 0px;
  -ScaleImage-symbolic: false;
}

/* a dot under running applications, as on GNOME's dash; two for an
   application with several windows */
button#taskbar_popup.running {
  background-image: radial-gradient(circle closest-side,
      alpha(@theme_fg_color, 0.7) 85%, transparent 100%);
  background-size: 5px 5px;
  background-repeat: no-repeat;
  background-position: 50% 100%;
}

button#taskbar_popup.several {
  background-image:
    radial-gradient(circle closest-side, alpha(@theme_fg_color, 0.7) 85%, transparent 100%),
    radial-gradient(circle closest-side, alpha(@theme_fg_color, 0.7) 85%, transparent 100%);
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat, no-repeat;
  background-position: 42% 100%, 58% 100%;
}

/* the list of an application's windows */
window#taskbar_popup {
  background: rgba(0,0,0,0);
}

grid#dock_windows {
  background-color: @popover_bg_color;
  border-radius: 14px;
  border: 1px solid alpha(@theme_fg_color, 0.12);
  padding: 6px;
  margin-bottom: 6px;
}

grid#dock_windows button#taskbar_item {
  border: none;
  border-radius: 9px;
  padding: 7px 10px;
  margin: 0px;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
}

grid#dock_windows button#taskbar_item:hover {
  background-color: alpha(@theme_fg_color, 0.09);
}

grid#dock_windows button#taskbar_item.focused {
  background-color: alpha(@theme_fg_color, 0.14);
}

grid#dock_windows button#taskbar_item.focused:hover {
  background-color: alpha(@theme_fg_color, 0.20);
}

grid#dock_windows button#taskbar_item image {
  min-width: 20px;
  min-height: 20px;
  padding: 0px 9px 0px 0px;
  -ScaleImage-symbolic: false;
}

grid#dock_windows button#taskbar_item label {
  font-size: 13px;
  font-weight: normal;
}

/* status panel items: every item is a 28 px cell with a 16 px icon, so the
   strip reads as one evenly spaced column */
window#status .module,
window#status button#module,
window#status button#session {
  background-color: transparent;
  border: none;
  border-radius: 9px;
  padding: 6px;
  margin: 0px;
  -GtkWidget-halign: center;
  -GtkWidget-vexpand: false;
}

window#status .module image,
window#status button#module image,
window#status button#session image,
window#status button#tray_item image {
  min-width: 16px;
  min-height: 16px;
  padding: 0px;
  margin: 0px;
  color: @theme_fg_color;
  -GtkWidget-halign: center;
}

window#status button#tray_item {
  padding: 6px;
  border-radius: 9px;
  -GtkWidget-halign: center;
}

window#status label {
  font-size: 11px;
  font-weight: bold;
}

/* the keyboard layout's flag: 20 x 15 in the same 28 px cell, in its own
   colours */
window#status image#language {
  min-width: 20px;
  min-height: 15px;
  margin: 0px;
  padding: 6px 4px 7px 4px;
  border-radius: 9px;
  -ScaleImage-symbolic: false;
  -GtkWidget-halign: center;
  -GtkWidget-vexpand: false;
}

window#status label#clock {
  min-width: 28px;
  padding: 5px 0px;
  margin: 0px;
  border-radius: 9px;
  font-size: 12px;
  -GtkWidget-vexpand: false;
  -GtkWidget-halign: center;
}

window#status image#language:hover,
window#status label#clock:hover,
window#status button#session:hover,
window#status button#tray_item:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

window#status button#session:active {
  background-color: alpha(@theme_fg_color, 0.22);
}

/* pressed state for everything clickable on the panels */
window#status .module:hover,
window#status button#module:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

window#status .module:active,
window#status button#module:active,
button#dock_launcher:active,
button#taskbar_popup:active,
grid#quick_cluster:active {
  background-color: alpha(@theme_fg_color, 0.22);
}

/* ---- torOS: popups look like libadwaita popovers ---- */

grid#quick_popup,
grid#XWifiPopup,
grid#XBluezPopup,
grid#volume_popup,
grid#backlight_popup,
grid#cal_popup_grid,
grid#SessionPopup {
  background-color: @popover_bg_color;
  color: @popover_fg_color;
  border-radius: 16px;
  border: 1px solid alpha(@theme_fg_color, 0.12);
  padding: 14px;
}

grid#volume_popup label,
grid#cal_popup_grid label,
grid#SessionPopup label,
label#XBluezName {
  font-size: 14px;
}

grid#cal_popup_grid label#cal_clock {
  font-size: 32px;
}

label#cal_clock_date {
  border-bottom: none;
}

/* the calendar's month and year arrows */
image#cal_arrow {
  padding: 6px;
  border-radius: 14px;
}

image#cal_arrow:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

/* ---- torOS: workspace dots ---- */

window#status grid#pager {
  border: none;
  margin: 4px 0px 5px 0px;
  padding: 0px;
  -GtkWidget-halign: center;
}

/* sfwbar fills an empty tray with a blank label, which would leave a gap */
window#status #tray > label {
  font-size: 1px;
  margin: -1px;
}

window#status button#pager_item {
  min-width: 7px;
  min-height: 7px;
  border: none;
  border-radius: 4px;
  margin: 2px;
  padding: 0px;
  background-image: none;
  box-shadow: none;
  background-color: alpha(@theme_fg_color, 0.30);
  -GtkWidget-halign: center;
}

window#status button#pager_item:hover {
  background-color: alpha(@theme_fg_color, 0.55);
}

window#status button#pager_item.focused {
  background-color: @theme_fg_color;
}

window#status button#pager_item.focused:hover {
  background-color: alpha(@theme_fg_color, 0.75);
}

window#status button#pager_item label {
  font-size: 1px;
  opacity: 0;
  margin: -1px;
}

/* ---- torOS: quick settings ---- */

grid#quick_cluster {
  border-radius: 9px;
  padding: 0px 6px;
  margin: 0px;
  -GtkWidget-direction: bottom;
  -GtkWidget-halign: center;
}

grid#quick_cluster:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

image#quick_indicator,
button#quick_indicator image {
  min-width: 16px;
  min-height: 16px;
  padding: 6px 0px;
  color: @theme_fg_color;
}

button#quick_indicator {
  border: none;
  padding: 0px;
  margin: 0px;
  background-color: transparent;
}

window#XQuick {
  background: rgba(0,0,0,0);
}

grid#quick_popup {
  padding: 16px;
  margin-right: 6px;
}

grid#quick_top {
  margin-bottom: 8px;
}

image#quick_battery_icon {
  min-width: 18px;
  min-height: 18px;
}

label#quick_battery {
  font-size: 13px;
  font-weight: bold;
  padding-left: 6px;
}

label#quick_spacer {
  -GtkWidget-hexpand: true;
}

image#quick_round {
  min-width: 18px;
  min-height: 18px;
  padding: 9px;
  margin-left: 8px;
  border-radius: 18px;
  background-color: alpha(@theme_fg_color, 0.10);
}

image#quick_round:hover {
  background-color: alpha(@theme_fg_color, 0.18);
}

image#quick_round:active {
  background-color: alpha(@theme_fg_color, 0.30);
}

grid#quick_slider {
  margin: 5px 0px;
}

image#quick_slider_icon {
  min-width: 18px;
  min-height: 18px;
  padding: 7px;
  margin-right: 6px;
  border-radius: 16px;
}

image#quick_slider_icon:hover {
  background-color: alpha(@theme_fg_color, 0.10);
}

#quick_scale {
  min-width: 250px;
  -GtkWidget-direction: right;
  -GtkWidget-hexpand: true;
  -GtkWidget-valign: center;
}

#quick_scale trough {
  min-height: 8px;
  border: none;
  border-radius: 4px;
  background-color: alpha(@theme_fg_color, 0.15);
}

#quick_scale:hover trough {
  background-color: alpha(@theme_fg_color, 0.24);
}

#quick_scale progress {
  min-height: 8px;
  border: none;
  border-radius: 4px;
  background-color: @theme_selected_bg_color;
}

#quick_scale:hover progress {
  background-color: shade(@theme_selected_bg_color, 1.08);
}

grid#quick_pill,
grid#quick_pill_on {
  min-width: 128px;
  border-radius: 22px;
  padding: 9px 14px;
  margin: 5px 4px 0px 4px;
  background-color: alpha(@theme_fg_color, 0.10);
  -GtkWidget-hexpand: true;
}

grid#quick_pill:hover {
  background-color: alpha(@theme_fg_color, 0.16);
}

grid#quick_pill_on {
  background-color: @theme_selected_bg_color;
}

grid#quick_pill_on:hover {
  background-color: shade(@theme_selected_bg_color, 1.08);
}

grid#quick_pill_on label,
grid#quick_pill_on image {
  color: @theme_selected_fg_color;
}

image#quick_pill_icon {
  min-width: 18px;
  min-height: 18px;
  padding-right: 11px;
}

label#quick_pill_title {
  font-size: 13px;
  font-weight: bold;
  -GtkWidget-halign: start;
}

label#quick_pill_sub {
  font-size: 11px;
  font-weight: normal;
  opacity: 0.8;
  -GtkWidget-halign: start;
}

/* ---- torOS: session menu ---- */

grid#session_grid {
  padding: 7px 10px;
  border-radius: 9px;
}

grid#session_grid:hover {
  background-color: alpha(@theme_fg_color, 0.09);
}

image#session_icon {
  min-width: 18px;
  min-height: 18px;
  padding-right: 12px;
}

grid#session_grid:active {
  background-color: alpha(@theme_fg_color, 0.20);
}

/* A row that has to be held (action[Hold] in toros-session.widget) fills up
   from the left in the two seconds that takes, and empties quickly when it is
   let go before. The two seconds are sfwbar's (BASE_WIDGET_HOLD_MS in
   build/patches/sfwbar-hold.patch); keep the two the same. */
grid#session_hold {
  padding: 7px 10px;
  border-radius: 9px;
  background-image: linear-gradient(alpha(@theme_selected_bg_color, 0.45),
      alpha(@theme_selected_bg_color, 0.45));
  background-repeat: no-repeat;
  background-size: 0% 100%;
  transition: background-size 220ms ease-out;
}

grid#session_hold:hover {
  background-color: alpha(@theme_fg_color, 0.09);
}

grid#session_hold:active {
  background-size: 100% 100%;
  transition: background-size 2s linear;
}

label#session_hint {
  font-size: 11px;
  font-weight: normal;
  color: alpha(@theme_fg_color, 0.55);
  padding: 6px 10px 0px 10px;
  -GtkWidget-halign: start;
}

/* ---- torOS: Wi-Fi window ---- */

grid#XWifiPopup {
  min-width: 300px;
  min-height: 340px;
}

label#XWifiHeader {
  font-size: 17px;
  font-weight: bold;
  padding-bottom: 8px;
  -GtkWidget-halign: start;
}

label#XWifiSeparator {
  font-size: 11px;
  font-weight: bold;
  color: alpha(@theme_fg_color, 0.55);
  border-bottom: none;
  padding: 8px 4px 2px 4px;
}

/* network rows: look and react like list buttons */
grid#XWifiGrid {
  padding: 8px 8px;
  border-radius: 9px;
}

grid#XWifiGrid:hover {
  background-color: alpha(@theme_fg_color, 0.09);
}

grid#XWifiGrid:active,
*:active > grid#XWifiGrid {
  background-color: alpha(@theme_fg_color, 0.20);
}

label#XWifiName {
  font-size: 14px;
}

label#XWifiType {
  font-size: 11px;
  color: alpha(@theme_fg_color, 0.55);
}

image#XWifiIcon,
image#XWifiIconConnected {
  min-height: 18px;
  min-width: 18px;
  padding-right: 9px;
}

image#XWifiIconConnected {
  color: @theme_selected_bg_color;
}

/* Scan is a button: filled, and it changes when pointed at and pressed.
   While scanning its text reads "Scanning ..." */
label#XWifiScan {
  border-top: none;
  border-radius: 9px;
  margin-top: 10px;
  padding: 8px;
  font-size: 13px;
  font-weight: bold;
  background-color: alpha(@theme_fg_color, 0.10);
}

label#XWifiScan:hover {
  background-color: alpha(@theme_fg_color, 0.18);
}

label#XWifiScan:active,
*:active > label#XWifiScan {
  background-color: alpha(@theme_fg_color, 0.30);
}

/* ---- torOS: Wi-Fi password window ---- */

grid#wifi_dialog_grid {
  padding: 18px;
}

label#wifi_dialog_title,
label#wifi_user_label,
label#wifi_passphrase_label {
  font-size: 14px;
}

label#wifi_dialog_title {
  font-weight: bold;
  padding-bottom: 12px;
}

label#wifi_user_label,
label#wifi_passphrase_label {
  padding-right: 10px;
}

entry#wifi_user_entry,
entry#wifi_passphrase_entry {
  min-width: 220px;
  margin-bottom: 6px;
}

entry#wifi_user_entry:hover:not(:focus),
entry#wifi_passphrase_entry:hover:not(:focus) {
  box-shadow: inset 0 0 0 1px alpha(@theme_fg_color, 0.20);
}

button#wifi_button_ok,
button#wifi_button_cancel {
  margin-top: 10px;
  padding: 7px;
  border: none;
  border-radius: 9px;
  background-color: alpha(@theme_fg_color, 0.10);
}

button#wifi_button_cancel:hover {
  background-color: alpha(@theme_fg_color, 0.18);
}

button#wifi_button_ok {
  margin-right: 8px;
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

button#wifi_button_ok:hover {
  background-color: shade(@theme_selected_bg_color, 1.08);
}

button#wifi_button_ok image {
  color: @theme_selected_fg_color;
}

/* ---- torOS: Bluetooth window, the same as the Wi-Fi window ---- */

grid#XBluezPopup {
  min-width: 300px;
}

label#XBluezHeader {
  font-size: 17px;
  font-weight: bold;
  padding-bottom: 8px;
  -GtkWidget-halign: start;
}

label#XBluezSeparator {
  font-size: 11px;
  font-weight: bold;
  color: alpha(@theme_fg_color, 0.55);
  border-bottom: none;
  padding: 8px 4px 2px 4px;
}

grid#XBluezGrid {
  padding: 8px 8px;
  border-radius: 9px;
}

grid#XBluezGrid:hover {
  background-color: alpha(@theme_fg_color, 0.09);
}

grid#XBluezGrid:active,
*:active > grid#XBluezGrid {
  background-color: alpha(@theme_fg_color, 0.20);
}

image#XBluezIcon {
  min-height: 18px;
  min-width: 18px;
  padding-right: 9px;
}

label#XBluezStatus,
label#XBluezClass {
  font-size: 11px;
  color: alpha(@theme_fg_color, 0.55);
}

label#XBluezScan {
  border-top: none;
  border-radius: 9px;
  margin-top: 10px;
  padding: 8px;
  font-size: 13px;
  font-weight: bold;
  background-color: alpha(@theme_fg_color, 0.10);
}

label#XBluezScan:hover {
  background-color: alpha(@theme_fg_color, 0.18);
}

label#XBluezScan:active,
*:active > label#XBluezScan {
  background-color: alpha(@theme_fg_color, 0.30);
}

/* tooltips: small, the same surface as the panels */
tooltip,
tooltip.background {
  background-color: @popover_bg_color;
  border: 1px solid alpha(@theme_fg_color, 0.15);
  border-radius: 8px;
}

tooltip label {
  font-size: 12px;
  font-weight: normal;
  color: @theme_fg_color;
  padding: 2px 4px;
}
