#!/bin/sh
# Read what the apps need to start into the page cache, so that the first
# start after login is as fast as a later one. Run once from labwc's autostart
# at the lowest CPU and disk priority. It only fills the cache (memory the
# kernel gives back at once when it is needed).
#
# Most of it is the browser: Thorium reads its whole program (290 MB) before
# it shows a window, which takes 3 s from the laptop's eMMC when nothing has
# read it before (first start 4.5-5 s without this, 2 s with it).
sleep 2
THORIUM=/opt/chromium.org/thorium

# The libraries a program is linked to
libs() {
	for bin; do
		ldd "$bin" 2>/dev/null | awk '$3 ~ /^\// { print $3 }'
	done
}

{
	# GTK4, libadwaita and the graphics drivers (Vulkan for GTK4 apps, OpenGL
	# for Oynaz and the browser), then the data every GTK app reads
	for lib in libgtk-4.so.1 libadwaita-1.so.0 libgio-2.0.so.0 libglib-2.0.so.0 libgobject-2.0.so.0 \
		libpango-1.0.so.0 libpangocairo-1.0.so.0 libcairo.so.2 libharfbuzz.so.0 libgraphene-1.0.so.0 \
		libgdk_pixbuf-2.0.so.0 librsvg-2.so.2 libvulkan.so.1 libvulkan_intel.so libepoxy.so.0 libEGL.so.1 \
		libGLdispatch.so.0 libgallium*.so libxml2.so.* libicuuc.so.* libicudata.so.* libfontconfig.so.1 \
		libfreetype.so.6 libgtksourceview-5.so.0 libwayland-client.so.0 libxkbcommon.so.0; do
		ls /usr/lib/$lib 2>/dev/null
	done
	ls /usr/lib/dri/iris_dri.so /usr/lib/gio/modules/*.so /usr/lib/gdk-pixbuf-2.0/*/loaders.cache 2>/dev/null
	ls /usr/share/glib-2.0/schemas/gschemas.compiled /usr/share/icons/Adwaita/icon-theme.cache \
		/usr/share/icons/hicolor/icon-theme.cache /usr/share/mime/mime.cache 2>/dev/null
	ls /usr/share/fonts/*/Inter*.ttf /usr/share/fonts/*/Inter*.otf /usr/share/fonts/*/AdwaitaMono-Regular.ttf \
		/var/cache/fontconfig/* 2>/dev/null

	# The browser, with the video driver it loads at start
	ls $THORIUM/thorium $THORIUM/resources.pak $THORIUM/icudtl.dat $THORIUM/v8_context_snapshot.bin \
		$THORIUM/chrome_100_percent.pak $THORIUM/chrome_200_percent.pak $THORIUM/locales/en-US.pak \
		$THORIUM/chrome_crashpad_handler /usr/lib/dri/iHD_drv_video.so 2>/dev/null
	libs $THORIUM/thorium

	# The other apps: the programs and what only they are linked to
	for bin in /usr/bin/nautilus /usr/libexec/gvfsd /usr/bin/gnome-text-editor /usr/bin/loupe /usr/bin/papers \
		/usr/bin/oynaz /usr/bin/foot; do
		ls $bin 2>/dev/null
		libs $bin
	done
} | awk '!seen[$0]++' | while read -r f; do
	cat "$f" > /dev/null 2>&1
done
