#!/bin/sh
# torOS self-test: prints system state to stdout, then powers off.
# Started from /etc/rc.local only inside the QEMU test harness.

TOROS_BOOT_SECS=$(cut -d" " -f1 /proc/uptime)
sleep "${1:-30}"

# RAM in use the way htop shows it: total - free - buffers - cache
used_mb() {
	awk '/^(MemTotal|MemFree|Buffers|Cached|SReclaimable):/ {v[$1]=$2}
	     END {printf "idle RAM used: %d MB\n",
	          (v["MemTotal:"]-v["MemFree:"]-v["Buffers:"]-v["Cached:"]-v["SReclaimable:"])/1024}' /proc/meminfo
}

sec() { printf '\n=== %s ===\n' "$1"; }

# Run a command as the desktop user inside the desktop session
U=$(id -nu 1000); R=/run/user/1000
session() {
	bus=$(tr '\0' '\n' < "/proc/$(pgrep -x labwc | head -n1)/environ" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p')
	su "$U" -c "XDG_RUNTIME_DIR=$R WAYLAND_DISPLAY=wayland-0 LANG=en_US.UTF-8 DBUS_SESSION_BUS_ADDRESS='$bus' $1"
}
theme_state() {
	echo "scheme: $(session 'toros-theme get'), color-scheme $(session 'gsettings get org.gnome.desktop.interface color-scheme'), gtk-theme $(session 'gsettings get org.gnome.desktop.interface gtk-theme')"
	pgrep -a swaybg | cut -d' ' -f2-
	grep -H initial-color-theme "/home/$U/.config/foot/foot.ini"
	grep -H 'window.active.title.bg.color' "/home/$U/.local/share/themes/torOS/labwc/themerc"
}
# running NAME...: which of these programs are running (matched by path, as
# several names are longer than the 15 characters "pgrep -x" can see)
running() {
	for p in "$@"; do
		pgrep -f "/$p( |\$)" >/dev/null && printf '%s ' "$p"
	done
}

echo "TOROS-SELFTEST-BEGIN"
sec kernel;    uname -a; cat /proc/cmdline
grep -H . /boot/loader/loader.conf /boot/loader/entries/*.conf 2>&1
echo "firmware that failed to load: $(dmesg | grep -ciE 'firmware.*(fail|error)|failed to load')"
sec memory;    free -m
used_mb
grep -E '^(AnonPages|Shmem|Slab|SUnreclaim|KernelStack|PageTables|Percpu|VmallocUsed):' /proc/meminfo
echo "loaded modules: $(($(wc -l < /proc/modules)))"
sec swap
grep -q '^/dev/zram' /proc/swaps && echo "zram swap: on" || echo "zram swap: MISSING"
zramctl; cat /var/log/toros-zram.log 2>/dev/null
sysctl vm.swappiness vm.page-cluster; echo "lru_gen min_ttl_ms: $(cat /sys/kernel/mm/lru_gen/min_ttl_ms 2>&1)"
sec services
for s in /var/service/*; do sv status "$s"; done
sec processes; ps -eo rss,user,args --sort=-rss | head -30
sec desktop
for p in labwc sfwbar pipewire wireplumber swaybg; do
	pgrep -f "(^|/)$p( |\$)|bin/$p" >/dev/null && echo "$p: running" || echo "$p: NOT running"
done
pgrep -f 'pipewire -c pipewire-pulse.conf' >/dev/null && echo "pipewire-pulse: running" || echo "pipewire-pulse: NOT running"
if pid=$(pgrep -x Xwayland); then
	echo "Xwayland: running for $(ps -o etimes= -p "$pid") s, private memory $(awk '/^Pss_Anon|^Pss_Shmem/ {s+=$2} END {print int(s/1024)}' "/proc/$pid/smaps_rollup") MB"
fi
for p in pipewire wireplumber sfwbar; do
	pid=$(pgrep -x "$p" | head -n1)
	[ -n "$pid" ] && tr '\0' '\n' < "/proc/$pid/environ" | grep -q '^DBUS_SESSION_BUS_ADDRESS=' \
		&& echo "$p: has session bus" || echo "$p: NO session bus"
done
# The portal, polkit, the accessibility bus and the file manager's helpers
# start on demand only
idle=$(running xdg-desktop-portal xdg-document-portal polkitd gvfsd udisksd localsearch-3 at-spi-bus-launcher)
[ -z "$idle" ] && echo "on-demand helpers: none running (ok)" || echo "on-demand helpers running on an idle desktop (unexpected): $idle"
[ -r "$R/toros-session-up" ] && echo "desktop session up at: $(cat "$R/toros-session-up") s after kernel start"
su "$U" -c "XDG_RUNTIME_DIR=$R wpctl status 2>&1" | sed -n '1,25p'
tail -n 15 "/home/$U/.local/state/toros/session.log" 2>/dev/null
echo "--- panel log"; tail -n 15 "/home/$U/.local/state/toros/panel.log" 2>/dev/null
sec splash
zcat /proc/config.gz | grep -E '^CONFIG_LOGO(_LINUX_CLUT224)?=|DEFERRED_TAKEOVER'
dmesg | grep -E 'fbcon|fb0' | cut -c1-120
cat /run/toros-splash.log 2>&1
echo "remembered for the next start's bar: $(cat /var/lib/toros/splash-time 2>&1) s"
pgrep -x splash >/dev/null && echo "splash is STILL RUNNING" || echo "splash has ended (ok)"
sec theme
theme_state
for f in .config/fuzzel/fuzzel.ini .config/mako/config .config/gtk-3.0/gtk.css \
	.config/gtk-4.0/gtk.css .local/share/themes/torOS/labwc/close-active.svg; do
	[ -s "/home/$U/$f" ] || echo "MISSING: ~/$f"
done
ls -d /usr/share/themes/adw-gtk3 /usr/share/themes/adw-gtk3-dark 2>&1
sec login;     who
sec mounts;    grep -E ' (/|/boot|/tmp) ' /proc/mounts
sec disk;      df -h / /boot
sec zapret
pgrep -a nfqws || echo "nfqws NOT running"
nft list ruleset 2>&1 | head -40
sec network;   ip -br link
sec bluetooth; ls /sys/class/bluetooth 2>/dev/null || echo "no adapter (expected in QEMU)"
sec passwordless-sudo
su "$(id -nu 1000)" -c 'sudo -n /usr/bin/rfkill unblock all 2>/dev/null && echo "allowed commands run without password: ok" || echo "allowed commands run without password: FAILS"'
su "$(id -nu 1000)" -c 'sudo -n /usr/bin/true 2>/dev/null && echo "other commands without password: ALLOWED (wrong)" || echo "other commands need the password: ok"'
sec user-ping; su nobody -s /bin/sh -c 'ping -c1 -W1 127.0.0.1' 2>&1 | tail -2
sec dmesg-problems
dmesg -l err,crit,alert,emerg | tail -30
sec boot-time; echo "kernel start to runit stage 2: ${TOROS_BOOT_SECS:-?} s"
sec memory-without-zapret
sv down zapret >/dev/null; sleep 3; nft list tables; used_mb

# Phase 4: apps, their start times, and the helpers that start on demand
sec phase4
for a in nautilus toros-files gnome-text-editor loupe papers zapret-gtk thorium-browser oynaz; do
	command -v "$a" >/dev/null || echo "MISSING app: $a"
done
tr '\n' ' ' < "/home/$U/.config/thorium/thorium-flags.conf"; echo
echo "page cache after prewarm: $(awk '/^Cached:/ {print int($2/1024)}' /proc/meminfo) MB"
# app start to window, first and second time (software rendering in the VM)
for run in first second; do
	session '/usr/lib/toros/apptime org.gnome.TextEditor gnome-text-editor' 2>&1 | sed "s/^/$run: /"
	sleep 2
done
session '/usr/lib/toros/apptime org.gnome.Nautilus toros-files' 2>&1
sleep 3
echo "left running after Files closed: $(running gvfsd polkitd udisksd)"
# zapret-gtk's root helper through polkit, without a password dialog
session 'pkexec /usr/bin/zapret-control cat-config' 2>&1 | grep -q NFQWS \
	&& echo "pkexec zapret-control: ok" || echo "pkexec zapret-control: FAILS"
session 'pkexec /usr/bin/true' >/dev/null 2>&1 </dev/null \
	&& echo "pkexec of other commands: ALLOWED (wrong)" || echo "pkexec of other commands is refused: ok"
echo "--- panel log"; tail -n 5 "/home/$U/.local/state/toros/panel.log" 2>/dev/null
used_mb

# Emoji picker and clipboard history: the watcher runs and files what is
# copied, and how long the picker takes from start to its first picture
sec picker
command -v toros-picker >/dev/null || echo "MISSING app: toros-picker"
if pid=$(pgrep -x toros-clipd); then
	echo "toros-clipd: running, $(awk '/^Pss:/ {print $2}' "/proc/$pid/smaps_rollup") kB"
else
	echo "toros-clipd: NOT running"
fi
session 'wl-copy "toros selftest" >/dev/null 2>&1'; sleep 1
echo "clipboard history: $(grep -lx 'toros selftest' "$R"/toros-clip/*.txt 2>/dev/null | wc -l) item(s) with the copied text (1 expected)"
echo "emoji font: $(session 'fc-match emoji')"
for run in first second; do
	t0=$(date +%s%N)
	session 'TOROS_PICKER_BENCH=1 toros-picker' 2>&1
	echo "$run: toros-picker drawn after $(( ($(date +%s%N) - t0) / 1000000 )) ms"
done

# Screenshots: how long the frozen screen takes from start to its first
# picture, and that a screenshot lands in Pictures/Screenshots and on the
# clipboard (its notification is gone again after the sleep)
sec shot
for a in toros-shot grim wf-recorder; do
	command -v "$a" >/dev/null || echo "MISSING app: $a"
done
for run in first second; do
	t0=$(date +%s%N)
	session 'TOROS_SHOT_BENCH=1 toros-shot' 2>&1
	echo "$run: toros-shot's frozen screen drawn after $(( ($(date +%s%N) - t0) / 1000000 )) ms"
done
session 'toros-shot screen >/dev/null 2>&1 &'; sleep 8
echo "screenshot: $(ls "/home/$U/Pictures/Screenshots" 2>/dev/null | grep -c '\.png$') file(s), $(session 'wl-paste -l' 2>/dev/null | grep -c '^image/png$') picture(s) on the clipboard (1 and 1 expected)"
pgrep -x toros-shot >/dev/null && echo "toros-shot is STILL RUNNING" || echo "toros-shot has ended (ok)"

# The overview (the Super key): how long it takes from start to the picture
# with the applications in it, and that nothing of it stays behind
sec overview
for run in first second; do
	t0=$(date +%s%N)
	session 'TOROS_OVERVIEW_BENCH=1 toros-overview' 2>&1
	echo "$run: toros-overview drawn with its tiles after $(( ($(date +%s%N) - t0) / 1000000 )) ms"
done
pgrep -x toros-overview >/dev/null && echo "toros-overview is STILL RUNNING" || echo "toros-overview has ended (ok)"

# The keyboard on the screen: how long it takes from start to its first
# picture, and that the compositor lets it type
sec keyboard
for run in first second; do
	t0=$(date +%s%N)
	session 'TOROS_KEYBOARD_BENCH=1 toros-keyboard' 2>&1 | grep -v -e MESA -e 'G[ds]k-WARNING' -e '^$'
	echo "$run: toros-keyboard drawn after $(( ($(date +%s%N) - t0) / 1000000 )) ms"
done
pgrep -x toros-keyboard >/dev/null && echo "toros-keyboard is STILL RUNNING" || echo "toros-keyboard has ended (ok)"

# The lock screen: how long it takes from start to the locked screen with its
# first picture (it then unlocks by itself) and that nothing of it stays
# behind. Then going to sleep (zzz -n runs the hooks and sleeps five seconds
# instead): it locks, a wrong password does not unlock and the image's first
# password does (typed through the compositor, as the keyboard would).
sec lock
for run in first second; do
	t0=$(date +%s%N)
	# (no pipe to read what it says: the lock screen holds it open after
	# toros-lock has come back)
	session 'TOROS_LOCK_BENCH=1 toros-lock >/dev/null 2>&1'
	echo "$run: toros-lock locked and drawn after $(( ($(date +%s%N) - t0) / 1000000 )) ms"
	sleep 1
done
pgrep -x toros-lock >/dev/null && echo "toros-lock is STILL RUNNING" || echo "toros-lock has ended (ok)"
zzz -n >/dev/null 2>&1 &
sleep 3
if lock=$(pgrep -x -n toros-lock); then
	echo "going to sleep: locked (ok), the lock screen uses $(awk '/^Pss:/ {print int($2/1024)}' "/proc/$lock/smaps_rollup") MB"
	session 'wtype wrong -k Return'; sleep 5
	pgrep -x toros-lock >/dev/null && echo "a wrong password: still locked (ok)" || echo "a wrong password UNLOCKED"
	session 'wtype toros -k Return'; sleep 3
	if pgrep -x toros-lock >/dev/null; then
		echo "the password did NOT unlock"; pkill -x -o toros-lock; pkill -x toros-lock
	else
		echo "the password: unlocked (ok)"
	fi
else
	echo "going to sleep: NOT locked"
fi
wait

# Keyboard layout: toros-layout puts another layout first and labwc reads its
# environment again (the panel's flag follows the keyboard)
sec layout
log="/home/$U/.local/state/toros/session.log"
before=$(grep -c "read environment file /home/$U/.config/labwc/environment" "$log" 2>/dev/null)
session 'toros-layout next'; sleep 1
echo "after 'toros-layout next': $(session 'toros-layout get') ($(sed -n 's/^XKB_DEFAULT_LAYOUT=//p' "/home/$U/.config/labwc/environment" 2>&1)), labwc read it $(( $(grep -c "read environment file /home/$U/.config/labwc/environment" "$log" 2>/dev/null) - before )) time(s) (tr and 1 expected)"
session 'toros-layout us'; sleep 1
echo "back to: $(session 'toros-layout get')"
for l in $(sed -n 's/^XKB_DEFAULT_LAYOUT=//p' /etc/xdg/labwc/environment | tr ',' ' '); do
	[ -s "/usr/share/toros/flags/$l.svg" ] || echo "MISSING flag: $l"
done
grep -q 'Hold' /usr/share/sfwbar/toros-session.widget && echo "session menu: rows are held (ok)" || echo "session menu: NO held rows"

# Open a terminal so the screenshot taken by test/qemu.sh shows a window
if [ -e /sys/firmware/qemu_fw_cfg/by_name/opt/toros/selftest ]; then
	echo "TOROS-SCREENSHOT idle"; sleep 4
	su "$U" -c "XDG_RUNTIME_DIR=$R WAYLAND_DISPLAY=wayland-0 LANG=en_US.UTF-8 foot >/dev/null 2>&1 &"
	sleep 3; echo "TOROS-SCREENSHOT window"; sleep 4
	echo "--- panel log after opening a window"; tail -n 8 "/home/$U/.local/state/toros/panel.log" 2>/dev/null

	# Virtual Wi-Fi on top of the VM's ethernet card (driver virt_wifi, one open
	# network called "VirtWifi"): checks that iwd survives bringing a device up,
	# gets an address and that traffic passes with zapret active.
	sec wifi
	modprobe virt_wifi && ip link set eth0 up && ip link add link eth0 name wlan0 type virt_wifi
	sleep 8
	ip -br link | grep -v '^lo'
	iwctl device list | sed 's/\x1b\[[0-9;]*m//g' | grep -vE '^ *$|^-'
	wdev=$(iwctl device list | sed 's/\x1b\[[0-9;]*m//g' | awk '/station/ {print $1; exit}')
	if [ -n "$wdev" ]; then
		iwctl station "$wdev" scan; sleep 4
		iwctl station "$wdev" connect VirtWifi; sleep 8
		iwctl station "$wdev" show | sed 's/\x1b\[[0-9;]*m//g' | grep -E 'State|Connected network|IPv4 address'
		ip -br addr | grep -v '^lo'
		cat /etc/resolv.conf 2>&1 | head -5
		curl -sS -m 10 -o /dev/null -w 'https fetch through zapret: HTTP %{http_code}\n' https://example.com 2>&1
	fi
	sv status iwd
	echo "iwd crashes in kernel log: $(dmesg | grep -c 'iwd.*segfault')"
	dmesg | grep -E 'iwd.*segfault|renamed from' | tail -n 4

	# Fire the panel's "Wi-Fi password needed" trigger (see sfwbar.config) to
	# check that its password window opens. The VM has no Wi-Fi hardware.
	sec wifi-prompt
	pkill -RTMIN+5 -x sfwbar
	sleep 4; echo "TOROS-SCREENSHOT wifi"; sleep 4
	echo "--- panel log after password prompt"; tail -n 8 "/home/$U/.local/state/toros/panel.log" 2>/dev/null

	# Switch the desktop to dark, as the panel's light/dark button does
	sec dark
	session 'toros-theme dark'; sleep 3
	theme_state
	echo "TOROS-SCREENSHOT dark"; sleep 4
fi
echo "TOROS-SELFTEST-END"
sync
poweroff
