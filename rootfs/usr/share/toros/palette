# torOS colours, as RRGGBB. This is the only place they are written down:
# toros-theme turns this file into the labwc, fuzzel, mako, foot and
# GTK settings, so the parts of the desktop cannot drift apart.
#
# The greys are libadwaita 1.9's and adw-gtk3's own, so everything matches
# GTK4 and GTK3 apps. The accent is the green of the logo.

accent=21ae68
accent_fg=ffffff
# the accent as a text colour: darker on light surfaces, lighter on dark ones
light_accent_text=17824c
dark_accent_text=57d897

# window background and text
light_bg=fafafb
dark_bg=222226
light_fg=323233
dark_fg=ffffff
# secondary text (the main text colour at 55 %)
light_dim=8c8c8d
dark_dim=9d9d9f

# title bars of windows that do not draw their own
light_headerbar=ebebed
dark_headerbar=2e2e32
# surfaces that float above windows: launcher, notifications, menus
light_popover=ffffff
dark_popover=36363a
# the row under the pointer or the selected row on such a surface
light_select=ebebed
dark_select=4a4a4e
# thin outlines
light_border=d4d4d6
dark_border=4b4b4f

# text areas: the terminal
light_view=ffffff
dark_view=1d1d20
light_view_fg=323233
dark_view_fg=ffffff

# shown while the wallpaper loads, and on the lock screen
light_desktop=c9d3dc
dark_desktop=1b1d24

# terminal colours 0-7 and 8-15 (GNOME's)
dark_term="171421 c01c28 26a269 a2734c 12488b a347ba 2aa1b3 d0cfcc"
dark_term_bright="5e5c64 f66151 33d17a e9ad0c 2a7bde c061cb 33c7de ffffff"
light_term="171421 c01c28 26a269 a2734c 12488b a347ba 2aa1b3 5e5c64"
light_term_bright="5e5c64 f66151 2ec27e e5a50a 2a7bde c061cb 2aa1b3 77767b"
