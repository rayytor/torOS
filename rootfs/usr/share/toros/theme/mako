# torOS notifications: the same look as the launcher and menus.
# Template: toros-theme fills in the colours and writes ~/.config/mako/config.
font=Inter 11
background-color=#@popover@
text-color=#@fg@
border-color=#@border@
progress-color=over #@select@
border-size=1
border-radius=14
padding=12
margin=10
width=340
default-timeout=6000
icons=1
max-icon-size=40
