#!/bin/sh
# Pick a Wi-Fi network and connect to it, asking for the password with the
# launcher (fuzzel). Independent of the panel's own Wi-Fi popup.
# Bound to Super+W and listed in the menu as "Wi-Fi networks".

say() { echo "$1"; notify-send -a Wi-Fi -i network-wireless-symbolic "Wi-Fi" "$1" 2>/dev/null; }
plain() { sed -e 's/\x1b\[[0-9;]*m//g'; }

sudo -n /usr/bin/rfkill unblock all 2>/dev/null
dev=$(iwctl device list | plain | awk '$NF == "station" || /station/ {print $1; exit}')
[ -n "$dev" ] || { say "No Wi-Fi device found."; exit 1; }

notify-send -a Wi-Fi -t 3000 -i network-wireless-acquiring-symbolic "Wi-Fi" "Scanning for networks…" 2>/dev/null
iwctl station "$dev" scan 2>/dev/null; sleep 3
# Table rows: optional "> " marker, then name, security and signal separated by 2+ spaces
ssid=$(iwctl station "$dev" get-networks | plain | tail -n +5 \
	| sed -e 's/^[ >]*//' -e '/^$/d' | awk -F'  +' '{print $1}' \
	| fuzzel --dmenu --prompt "Wi-Fi  ")
[ -n "$ssid" ] || exit 0

notify-send -a Wi-Fi -t 4000 -i network-wireless-acquiring-symbolic "Wi-Fi" "Connecting to $ssid…" 2>/dev/null
if iwctl known-networks list | plain | grep -qF "  $ssid  "; then
	out=$(iwctl station "$dev" connect "$ssid" 2>&1)
else
	pass=$(fuzzel --dmenu --password --lines 0 --prompt "Password for $ssid  " < /dev/null)
	[ -n "$pass" ] || exit 0
	out=$(iwctl --passphrase "$pass" station "$dev" connect "$ssid" 2>&1)
fi

sleep 2
if iwctl station "$dev" show | plain | grep -q 'State *connected'; then
	say "Connected to $ssid."
else
	say "Could not connect to $ssid. ${out}"
	exit 1
fi
