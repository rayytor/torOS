#!/bin/sh
# Files (Nautilus). Its helper for the wastebasket, USB sticks and phones
# (gvfsd) is started here and stopped when the last Files window has closed,
# instead of running all the time: D-Bus would start it for every app that
# opens a file (the build removes its service file).
uid=$(id -u)
GVFS='^/usr/libexec/(gvfsd|gvfs-)'

if ! pgrep -u "$uid" -x gvfsd >/dev/null; then
	/usr/libexec/gvfsd >/dev/null 2>&1 &
	i=0
	while [ $i -lt 20 ] && ! dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
		org.freedesktop.DBus.NameHasOwner string:org.gtk.vfs.Daemon 2>/dev/null | grep -q true; do
		i=$((i + 1)); sleep 0.1
	done
fi
/usr/bin/nautilus "$@"
status=$?
# "nautilus FOLDER" while Files is open only passes the folder on
pgrep -u "$uid" -x nautilus >/dev/null || pkill -u "$uid" -f "$GVFS"
exit $status
