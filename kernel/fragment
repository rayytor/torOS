# torOS kernel options, applied by build/kernel.sh on top of
#   Void's stock config  ->  "make localmodconfig" with lsmod-laptop.txt
# (which drops every module the laptop does not load). The build fails if a
# line here does not end up in the final config.
#
# Needed to boot with no initramfs is everything on the way to the root file
# system: on the eMMC, on the USB stick, and on QEMU's virtio disk (test VM).

# --- general
CONFIG_LOCALVERSION="-toros"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KERNEL_ZSTD=y
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_BOOT_CONFIG is not set
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_NR_CPUS=4
# CONFIG_NUMA is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_MODULE_COMPRESS is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- command line (PARTLABEL, not PARTUUID: a push does not rewrite the
#     partition table, so the stick keeps the IDs of the image it was written
#     from; rootwait because a USB stick shows up late, and no extra second
#     of waiting before its partitions are read; the logo once, in the
#     middle of the screen, instead of one per processor in the corner)
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="root=PARTLABEL=torOS rootfstype=ext4 rootwait usb-storage.delay_use=0 rw quiet loglevel=0 net.ifnames=0 vt.global_cursor_default=0 fbcon=logo-pos:center,logo-count:1"
# CONFIG_CMDLINE_OVERRIDE is not set

# --- firmware inside the kernel image: CPU microcode and the display
#     firmware i915 asks for before the root file system is there
#     (EXTRA_FIRMWARE_DIR is set by build/kernel.sh)
CONFIG_MICROCODE=y
CONFIG_EXTRA_FIRMWARE="intel-ucode/06-7a-08 i915/glk_dmc_ver1_04.bin"
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# --- built in: storage and file systems
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_CQHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFIVAR_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- built in: display (i915 early, so the screen is ours from the start)
# CONFIG_AGP is not set
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_ACPI_WMI=y
CONFIG_ACPI_VIDEO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- splash: the torOS logo (kernel/logo.ppm replaces the penguin, see
#     build/kernel.sh) as soon as the display driver is up. For that the
#     console must take the screen at once, not at the first message (there
#     are none). The firmware's own frame buffer drivers are left out, so the
#     logo is drawn once, by the real driver; the laptop never used them.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
# CONFIG_FB_EFI is not set
# CONFIG_FB_VESA is not set
#     The kernel's first program is the splash (build/splash.c), which hides
#     the console and then starts runit, so not even runit's own first lines
#     are drawn over the logo. If it is missing the kernel goes on to
#     /sbin/init by itself; "init=" on the command line still wins.
CONFIG_DEFAULT_INIT="/usr/lib/toros/splash"

# --- built in: keyboard, touchpad, USB input, power
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_INPUT_EVDEV=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- modules the laptop needs but did not have loaded when lsmod was taken
CONFIG_BT_HIDP=m
CONFIG_LENOVO_WMI_HOTKEY_UTILITIES=m
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m
CONFIG_UHID=m
CONFIG_SND_USB_AUDIO=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_FUSE_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_TUN=m
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
# phone tethering over USB
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m

# --- zapret (nfqws + nftables); the loaded ones come from lsmod, these are
#     what other strategies and tpws mode use
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_CONNTRACK=m
CONFIG_NFT_CT=m
CONFIG_NFT_QUEUE=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SOCKET=m

# --- test VM (QEMU): disk is above; these are its other devices
CONFIG_VIRTIO_NET=m
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRT_WIFI=m
CONFIG_FW_CFG_SYSFS=m
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y

